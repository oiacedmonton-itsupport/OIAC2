---
import { mediaUrl } from "../lib/media-url";
import { getFeaturedPosters, getSetting } from '../lib/db';

let sectionVisible: unknown = false;
let posters: Awaited<ReturnType<typeof getFeaturedPosters>> = [];
try {
  sectionVisible = await getSetting('featured_posters_visible');
  posters = sectionVisible !== false ? await getFeaturedPosters() : [];
} catch (error) {
  console.error('Failed to load featured posters:', error);
  sectionVisible = false;
  posters = [];
}
const showSection = sectionVisible !== false && posters.length > 0;
---

{showSection && (
<section class="px-4 py-4 md:px-8 mx-auto">
  <div class="container lg:max-w-4xl">
    <div class={`
      grid gap-4
      ${posters.length === 1 ? 'grid-cols-1 max-w-xs mx-auto' : ''}
      ${posters.length === 2 ? 'grid-cols-1 sm:grid-cols-2 max-w-2xl mx-auto' : ''}
      ${posters.length === 3 ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3' : ''}
      ${posters.length >= 4 ? 'grid-cols-2 sm:grid-cols-2 lg:grid-cols-4' : ''}
    `}>
      {posters.map((poster) => (
        <div class="group relative rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300 bg-gray-50 border border-gray-100">
          {poster.linkUrl ? (
            <a href={poster.linkUrl} target="_blank" rel="noopener noreferrer" class="block">
              <div class="relative aspect-[3/4] overflow-hidden">
                <img
                  src={mediaUrl(poster.imageUrl)}
                  alt={poster.title}
                  class="w-full h-full object-contain group-hover:scale-[1.03] transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            </a>
          ) : (
            <div class="relative aspect-[3/4] overflow-hidden">
              <img
                src={mediaUrl(poster.imageUrl)}
                alt={poster.title}
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
          )}
          {((poster.link1Text && poster.link1Url) || (poster.link2Text && poster.link2Url)) && (
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent pt-8 pb-3 px-3 flex flex-col gap-2">
              {poster.link1Text && poster.link1Url && (
                <a
                  href={poster.link1Url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-terracottaRed hover:bg-terracottaRed-darker text-white px-4 py-2 rounded-lg text-xs font-semibold shadow-md transition-colors block text-center"
                >
                  {poster.link1Text}
                </a>
              )}
              {poster.link2Text && poster.link2Url && (
                <a
                  href={poster.link2Url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-white/20 hover:bg-white/30 backdrop-blur-sm border border-white/60 text-white px-4 py-2 rounded-lg text-xs font-semibold shadow-md transition-colors block text-center"
                >
                  {poster.link2Text}
                </a>
              )}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
)}
